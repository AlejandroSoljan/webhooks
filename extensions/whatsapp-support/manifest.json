{
  "manifest_version": 3,
  "name": "Asisto · Tareas de WhatsApp",
  "version": "1.0.2",
  "minimum_chrome_version": "116",
  "description": "Revisá las tareas de Asisto junto a tus contactos de WhatsApp Web y guardalas en HubSpot.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://asistobot.com.ar/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Tareas de Asisto" },
  "content_scripts": [
    { "matches": ["https://web.whatsapp.com/*"], "js": ["contacts-main.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://web.whatsapp.com/*"], "js": ["matcher.js", "content.js"], "css": ["content.css"], "run_at": "document_idle" }
  ]
}
