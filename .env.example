# Plantilla mínima de desarrollo; no constituye un sandbox automático.
# Revisar inicializadores antes de arrancar; usar datos sintéticos.
NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/asisto_dev
MONGODB_DBNAME=asisto_dev
# Variables adicionales: docs/manual-tecnico/entorno.md y capítulo funcional.
# Nunca pegar credenciales productivas. .env no se versiona.
